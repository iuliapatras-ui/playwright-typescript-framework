{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-spec.mjs\"",
            "timeout": 300,
            "statusMessage": "Verifying edited spec..."
          }
        ]
      }
    ]
  }
}
